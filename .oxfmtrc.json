{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".turbo/**",
    ".vercel/**",
    ".pnpm-store/**",
    "coverage/**",
    "pnpm-lock.yaml"
  ]
}
