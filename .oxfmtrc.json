{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".turbo/**",
    ".vercel/**",
    ".bun/**",
    "coverage/**",
    "repos/**",
    "bun.lock",

    "**/__fixtures__/**",
    "docs/n8n/*.json",
    ".claude/skills/**/references/**"
  ]
}
