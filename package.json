{
  "name": "lavega",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "turbo run test",
    "test:watch": "turbo watch test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @lavega/server start",
    "typecheck": "turbo run typecheck",
    "db:migrate": "tsx --env-file-if-exists=apps/server/.env scripts/migrate.ts apply",
    "db:migrate:check": "tsx --env-file-if-exists=apps/server/.env scripts/migrate.ts check",
    "db:migrate:status": "tsx --env-file-if-exists=apps/server/.env scripts/migrate.ts status",
    "db:migrate:baseline": "tsx --env-file-if-exists=apps/server/.env scripts/migrate.ts baseline",
    "lint": "oxlint . --max-warnings 101",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "quality": "turbo run lint format",
    "quality:fix": "turbo run lint:fix format:fix",
    "orbstack:investing": "bash scripts/rebuild-investing-orbstack.sh",
    "sync:n8n": "node scripts/sync-n8n-code.mjs",
    "catalog:sweep": "tsx --env-file-if-exists=apps/server/.env scripts/catalog-sweep.ts",
    "catalog:find-pdfs": "tsx scripts/find-tariff-pdfs.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@lavega/core": "workspace:*",
    "@lavega/database": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@shadcn/lint": "^0.1.0",
    "@vercel/oidc": "3.2.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4",
    "turbo": "2.10.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0"
}
