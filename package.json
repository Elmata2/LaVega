{
  "name": "lavega",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @lavega/web dev",
    "dev:server": "pnpm --filter @lavega/server dev",
    "build": "pnpm --filter @lavega/web build",
    "start": "pnpm --filter @lavega/server start",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/adapters && tsc --noEmit -p apps/web && tsc --noEmit -p apps/server"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
