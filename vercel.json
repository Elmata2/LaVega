{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "env": {
    "LAVEGA_VAULT_FILE": "/tmp/lavega-vault.json",
    "LAVEGA_AGENT_RUN_FILE": "/tmp/lavega-agent-run.json",
    "LAVEGA_BROKER_SYNC_STATE_FILE": "/tmp/lavega-broker-sync.json",
    "INVESTING_PRICE_STORE_FILE": "/tmp/lavega-prices.json",
    "INVESTING_BENCHMARK_STORE_FILE": "/tmp/lavega-benchmarks.json",
    "INVESTING_MARKET_DATA_CONSENT_FILE": "/tmp/lavega-market-data-consent.json",
    "INVESTING_SECTOR_STORE_FILE": "/tmp/lavega-sectors.json"
  },
  "functions": {
    "api/[...route].js": {
      "excludeFiles": "**/.lavega/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/privacy", "destination": "/api/privacy" },
    { "source": "/terms", "destination": "/api/terms" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/investing/:path*", "destination": "/investing/index.html" }
  ]
}
