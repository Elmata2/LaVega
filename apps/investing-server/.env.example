PORT=8788

# Optional. Omit for interactive unlock through Broker koppelen.
# Store real value only in ignored .env or deployment secret storage.
LAVEGA_VAULT_PASSPHRASE=

# Optional file overrides. Local defaults use apps/investing-server/.lavega/.
# Docker defaults use /data/ when that directory exists.
LAVEGA_VAULT_FILE=
INVESTING_PRICE_STORE_FILE=

# Dev only, set to 1. Seeds a canned portfolio and price history, and skips
# real broker sync, so the dashboard renders instantly with no network calls.
# Never set this in production.
INVESTING_DEV_FIXTURE=
# Optional persistent benchmark-selection file. Defaults to .lavega/benchmarks.json.
INVESTING_BENCHMARK_STORE_FILE=

# Optional persisted Yahoo Finance consent file. Defaults to .lavega/market-data-consent.json.
INVESTING_MARKET_DATA_CONSENT_FILE=

# Optional portfolio investor agents. OpenRouter by default; any
# OpenAI-compatible local/self-hosted model can override the base URL.
LAVEGA_AGENT_API_KEY=
LAVEGA_AGENT_BASE_URL=https://openrouter.ai/api/v1
LAVEGA_AGENT_MODEL=
