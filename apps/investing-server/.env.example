PORT=8788

# Optional. Omit for interactive unlock through Broker koppelen.
# Store real value only in ignored .env or deployment secret storage.
LAVEGA_VAULT_PASSPHRASE=

# Optional file overrides. Local defaults use apps/investing-server/.lavega/.
# Docker defaults use /data/ when that directory exists.
LAVEGA_VAULT_FILE=
INVESTING_PRICE_STORE_FILE=

# Dev only, set to 1. Seeds a canned portfolio and price history, and skips
# real broker sync, so the dashboard renders instantly with no network calls.
# Never set this in production.
INVESTING_DEV_FIXTURE=
