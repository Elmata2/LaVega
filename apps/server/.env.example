# LaVega server — omgevingsvariabelen
#
# Kopieer dit bestand naar `.env` in DEZE map (apps/server/.env) en vul in wat je
# nodig hebt. `.env` staat in .gitignore en hoort daar te blijven staan; dit
# voorbeeldbestand is het enige dat in de repo mag staan.
#
#   cp apps/server/.env.example apps/server/.env
#
# `pnpm dev` leest het bestand automatisch (--env-file-if-exists), dus er is geen
# dotenv-pakket nodig. Bestaat het niet, dan start de server gewoon op en zijn de
# AI-functies uit — dat is de bedoelde toestand, geen fout.
#
# Op Railway zet je deze waarden als service-variabelen en NIET in een bestand.

# --- Neon + auth ------------------------------------------------------------
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8787,http://localhost:5173
LAVEGA_ENCRYPTION_KEY=

# --- AI ---------------------------------------------------------------------
# Zonder deze sleutel geeft /api/agent/status `configured: false` en antwoorden
# alle agent-routes met 503 "niet geconfigureerd". Dat is precies wat er tijdens
# het testen op 2026-08-17 gebeurde: de reisagent leek stuk terwijl er alleen
# geen sleutel stond. Zet hem, of laat hem leeg en weet dat AI dan uit is.
ANTHROPIC_API_KEY=

# --- n8n → LaVega -----------------------------------------------------------
# Gedeeld geheim voor POST /api/card-terms/ingest (kaarttarieven, publieke data).
# Niet gezet = endpoint dicht (503). Zelfde waarde als LAVEGA_INGEST_TOKEN in n8n.
#   openssl rand -hex 24
CARD_TERMS_INGEST_TOKEN=

# --- Enable Banking (optioneel) ---------------------------------------------
# Alleen nodig als je de banksync lokaal wilt draaien. Zonder deze waarden werkt
# de rest van de server normaal; alleen de /api/eb-routes zijn dan uit.
# De private key hoort NOOIT in de repo — verwijs naar een pad buiten de repo.
EB_APPLICATION_ID=
EB_PRIVATE_KEY_FILE=
# EB_PRIVATE_KEY=        # alternatief voor het bestandspad; let op regeleindes
# EB_REDIRECT_URL=
# EB_PSU_TYPE=
