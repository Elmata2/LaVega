{
  "name": "@lavega/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "LAVEGA_ALLOW_UNAUTHENTICATED=1 tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@lavega/adapters": "workspace:*",
    "@lavega/core": "workspace:*",
    "@lavega/database": "workspace:*",
    "@lavega/investing-server": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@sentry/node": "^10.70.0",
    "better-auth": "^1.7.1",
    "effect": "^4.0.1",
    "hono": "^4.13.7",
    "posthog-node": "^5.55.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
