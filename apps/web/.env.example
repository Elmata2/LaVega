# Optional. Browser error reporting, read at build time. Unset = Sentry is not
# initialised and no request is made. On Vercel the Sentry integration's
# SENTRY_DSN is forwarded here by scripts/vercel-build.mjs; set this only to
# override it, or for a Docker/local build with no integration.
VITE_SENTRY_DSN=

# Optional. Browser analytics. Set both values to enable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
