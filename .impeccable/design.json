  "narrative": {
    "northStar": "The Private Ledger",
    "overview": "A quiet, bookish record of what you own and why. Warm paper under white cards, a serif voice for headings, one deep ledger-blue for action. Numbers are the content: tabular, aligned, never decorated. The interface reads like a well-kept personal ledger, not a trading floor.\n\nDensity is calm and moderate. Surfaces are soft-lifted and rounded; controls are tactile, with a small press-scale. Color is rare and meaningful: blue means act, green and rust mean gain and loss, amber means caution.",
    "keyCharacteristics": [
      "Warm paper canvas, white cards, hairline borders.",
      "EB Garamond for headings, Inter for everything else.",
      "Generous radii: cards 22px, tiles 14px, pill buttons.",
      "Diffuse, low-contrast shadows; no hard drop shadows.",
      "Tabular numerals on every figure."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Ledger Blue is the single action color; it never doubles as a data series.",
        "section": "colors"
      },
      {
        "name": "The Gain/Loss Rule",
        "body": "Green and rust carry meaning only for gain and loss; never use them as decoration or series colors.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure uses tabular numerals so columns align and changes do not jitter.",
        "section": "typography"
      },
      {
        "name": "The Quiet Shadow Rule",
        "body": "Shadows are long, soft and low in opacity; empty cards drop the shadow and use a dashed border.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use tabular numerals for every figure.",
      "Do keep Ledger Blue as the only action color.",
      "Do show unknown figures as unknown with a reason.",
      "Do honor `prefers-reduced-motion` for all transitions.",
      "Do use the semantic radius tokens (card, tile, chip, pill), not ad hoc values."
    ],
    "donts": [
      "Don't drift toward neon crypto-trading dashboards: no glow, gamified gradients, or dark-only terminals.",
      "Don't use green or rust except for gain and loss.",
      "Don't use hard, short drop shadows.",
      "Don't use a sans-serif for card titles; headings stay EB Garamond."
    ]
  }
}