node_modules/
dist/
.turbo/
config.json
state.json
# ...except the product catalogue's diff anchor. It carries no secrets and no
# rates — only product identity and fetch routing — and it is USELESS outside
# git: its whole job is to make a moved figure show up as a reviewable diff.
!docs/catalog/state.json
*.pem
.env
.env.*
# ...except the template, which carries no secrets and is the only way a new
# machine knows which variables exist at all.
!.env.example
!**/.env.example
.DS_Store
.superpowers/
.worktrees/
.gstack/
.lavega/

# Local Claude state stays out of the repo; the verification skills in
# .claude/skills are checked in, because every agent working here needs them.
.claude/*
!.claude/skills/
.vercel

# The pnpm store is global (pnpm's default) and shared by every worktree.
# .githooks/post-checkout links it into a fresh worktree. A stale repo-local
# store from an older install is still ignored.
.pnpm-store/
.env.local
